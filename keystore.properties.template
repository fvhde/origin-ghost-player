# Copy this file to `keystore.properties` (same directory) on the machine that holds your
# signing key, then fill in the real values. `keystore.properties`, *.jks and *.keystore are
# gitignored — NEVER commit them. This template is safe to commit.
#
# This project is signed with the SAME key as origin-isle (same maintainer, same trust anchor —
# both apps' certificate fingerprints match). Point storeFile at your existing
# originisle-release.jks: either an absolute path, or copy/symlink it into this repo root and
# reference it as ../originisle-release.jks (resolved relative to the app module, app/).
#
# Only generate a NEW key if you want this project to have its own separate signing identity
# instead:
#
#   keytool -genkeypair -v -keystore originghostplayer-release.jks -alias originghostplayer \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../originisle-release.jks
storePassword=CHANGE_ME
keyAlias=originisle
keyPassword=CHANGE_ME
